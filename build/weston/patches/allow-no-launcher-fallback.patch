--- a/libweston/launcher-util.c
+++ b/libweston/launcher-util.c
@@ -32,10 +32,74 @@
 #include "launcher-impl.h"
 
 #include <errno.h>
+#include <fcntl.h>
+#include <stdlib.h>
 #include <stdint.h>
 #include <unistd.h>
 #include <linux/input.h>
 
+static const struct launcher_interface launcher_nolaunch_iface;
+
+/* Minimal launcher that just uses direct open/close without VT control.
+ * This is a permissive fallback so Weston can run when no launcher/logind is available. */
+static int
+launcher_nolaunch_connect(struct weston_launcher **launcher_out,
+			  struct weston_compositor *compositor,
+			  int tty, const char *seat_id, bool sync_drm)
+{
+	struct weston_launcher *launcher = calloc(1, sizeof *launcher);
+
+	if (!launcher)
+		return -ENOMEM;
+
+	launcher->iface = &launcher_nolaunch_iface;
+	*launcher_out = launcher;
+
+	weston_log("No launcher/logind available; falling back to direct open/close.\n");
+	return 0;
+}
+
+static void
+launcher_nolaunch_destroy(struct weston_launcher *launcher)
+{
+	free(launcher);
+}
+
+static int
+launcher_nolaunch_open(struct weston_launcher *launcher,
+		       const char *path, int flags)
+{
+	return open(path, flags);
+}
+
+static void
+launcher_nolaunch_close(struct weston_launcher *launcher, int fd)
+{
+	close(fd);
+}
+
+static int
+launcher_nolaunch_activate_vt(struct weston_launcher *launcher, int vt)
+{
+	return -ENOSYS;
+}
+
+static int
+launcher_nolaunch_get_vt(struct weston_launcher *launcher)
+{
+	return -ENOSYS;
+}
+
+static const struct launcher_interface launcher_nolaunch_iface = {
+	.name = "no-launcher-fallback",
+	.connect = launcher_nolaunch_connect,
+	.destroy = launcher_nolaunch_destroy,
+	.open = launcher_nolaunch_open,
+	.close = launcher_nolaunch_close,
+	.activate_vt = launcher_nolaunch_activate_vt,
+	.get_vt = launcher_nolaunch_get_vt,
+};
+
 static const struct launcher_interface *ifaces[] = {
 #ifdef HAVE_LIBSEAT
 	&launcher_libseat_iface,
@@ -45,6 +109,7 @@
 #endif
 	&launcher_weston_launch_iface,
 	&launcher_direct_iface,
+	&launcher_nolaunch_iface,
 	NULL,
 };
 

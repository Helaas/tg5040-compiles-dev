/llm*
.DS_Store

# Ignore build outputs
/build/*

# Allow top-level weston build tree but still ignore generated artifacts
!/build/weston
/build/weston/build
/build/weston/.stamps
/build/weston/deploy
/build/weston/weston.tar.gz

# Keep the launcher/config scripts that are authored, not generated
/build/weston/prefix/**
!/build/weston/prefix/
!/build/weston/prefix/launch.sh
!/build/weston/prefix/weston.ini
!/build/weston/prefix/bin/
/build/weston/prefix/bin/*
!/build/weston/prefix/bin/run-weston.sh

# Keep inputs/config we need for reproducible builds
!/build/weston/crossfile.meson
!/build/weston/native.meson
!/build/weston/src

# Keep only source tarballs, ignore extracted directories
/build/weston/src/*
!/build/weston/src/*.tar.gz
!/build/weston/src/*.tar.xz

# Allow the x11 build tree overall but keep tracked sources/tools
!/build/x11
/build/x11/build
/build/x11/.stamps
/build/x11/prefix
!/build/x11/Makefile
!/build/x11/src
!/build/x11/src/*.tar.gz
!/build/x11/src/*.tar.xz
